###############################################################################
# Wiki Pipeline — Environment Configuration
# Copy to .env and fill in your values before running the pipeline.
###############################################################################

# --- Ollama Connection ---
OLLAMA_URL=http://192.168.0.14:11434
EMBED_MODEL=snowflake-arctic-embed2:568m
EMBED_DIM=1024

# --- Gating Model (used by wiki_crawler.py and chunk_gate.py) ---
GATE_MODEL_NAME=qwen3-30b-dataset

# --- Wikipedia Crawler Settings ---
WIKI_LANG=en
WIKI_USER_AGENT=WikiLLMGateCrawler/1.0 (mailto:proximableu@gmail.com)
MIN_TEXT_LENGTH=1500
MAX_TITLE_LENGTH=200
RATE_LIMIT_DELAY=0.35
REQUEST_TIMEOUT=30

# --- Chunk Settings ---
SPLITTER_MAX_TOKENS=2048
SPLITTER_MAX_CHARS=3000
SPLITTER_TOKENIZER_MODEL=gpt-4o-mini

# --- Deduplication (build_db_vec.py / retriever.py) ---
DEDUP_JACCARD_THRESHOLD=0.65
NUM_PERM_INGESTION=256
NUM_PERM_RETRIEVAL=128

# --- SQLite-vec HNSW Parameters (retriever.py) ---
HNSW_M=32
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=100

# --- Lightweight LLM for relevance filtering ---
LIGHTWEIGHT_LLM_MODEL=llama3.2:3b
