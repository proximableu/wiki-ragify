/* Wiki Ragify TUI — layout + palette for the full-screen multi-screen app.
 *
 * Three regions: the central progress window (FR-3), the rolling stats panel
 * (FR-4), and a footer carrying the query box (FR-8) and the run controls
 * (CONFIG | RUN | PAUSE | RESUME | STOP | QUIT, §6/§7). The project/folder picker
 * moved to the CONFIG modal (Textual 8.2.8 has no file-browser widget), so #main
 * holds only the progress window and stats panel.
 *
 * NOTE: literal color values are used (not Textual custom variables). Textual
 * 8.2.8 cannot parse a stylesheet that references an undefined variable, so any
 * `$var` that isn't defined drops the entire stylesheet and the panels render
 * blank. Keeping the palette inline means every rule parses independently.
 *
 * The progress/stats panels are RichLog widgets (not Tables), so styling targets
 * their rows via the LogRow styles (see eventlog.py); the run-controls and query
 * box are plain widgets in a Container(id="footer").
 */

Screen {
    layout: vertical;
    background: #1b1b1b;
    color: #e6e6e6;
}

/* --- Top bar: run-status indicator ------------------------------------------ */

#status-indicator {
    dock: top;
    height: 1;
    padding: 0 1;
    background: #f0ad4e;
    color: #1b1b1b;
    text-style: bold;
}

#status-indicator.running {
    background: #2f9e44;
    color: #ffffff;
}

#status-indicator.paused {
    background: #f0ad4e;
    color: #1b1b1b;
}

#status-indicator.stopped {
    background: #d9534f;
    color: #ffffff;
}

#status-indicator.idle {
    background: #3b5bdb;
    color: #ffffff;
}

/* --- Main region: folder tree | progress | stats -------------------------- */

#main {
    layout: horizontal;
    height: 1fr;
}

#progress-panel {
    width: 1fr;
    border-right: round #3a3a3a;
    background: #1b1b1b;
    layout: vertical;
}

#stage-banner {
    height: 3;
    padding: 0 1;
    content-align: center middle;
    background: #232323;
    border-bottom: round #3a3a3a;
    text-style: bold;
    color: #e6e6e6;
}

#progress-log {
    width: 1fr;
    height: 1fr;
}

#stats-panel {
    width: 1fr;
    background: #232323;
}

/* --- Footer: query box + run controls ------------------------------------- */

#footer {
    dock: bottom;
    height: 3;
    layout: horizontal;
    border-top: round #3a3a3a;
    background: #232323;
    padding: 0 1;
}

#query-input {
    dock: left;
    width: 60%;
}

#query-input Input {
    background: #1b1b1b;
    color: #e6e6e6;
}

#run-controls {
    dock: right;
    align-vertical: middle;
}

#run-controls Button {
    margin: 0 1;
}

#run-controls #config-button {
    background: #3b5bdb;
    color: #ffffff;
}

#run-controls #run-button {
    background: #2f9e44;
    color: #ffffff;
}

#run-controls #pause-button {
    background: #f0ad4e;
    color: #1b1b1b;
}

#run-controls #resume-button {
    background: #5bc0de;
    color: #1b1b1b;
}

#run-controls #stop-button {
    background: #d9534f;
    color: #ffffff;
}

#run-controls #quit-button {
    background: #6c757d;
    color: #ffffff;
}

/* --- Query results overlay ------------------------------------------------ */

#query-overlay {
    width: 70%;
    height: 70%;
    dock: top;
    content-align-vertical: middle;
    border: round #7c4dff;
    background: #1b1b1b;
    color: #e6e6e6;
}

#query-overlay #query-message {
    padding: 0 1;
}

#query-overlay #query-table {
    padding: 1 0;
}

#query-overlay #query-back-actions {
    dock: bottom;
    height: 3;
    align-horizontal: center;
}

#query-overlay #query-back {
    background: #7c4dff;
    color: #ffffff;
}

/* --- Config modal (start page + prompt entry) ----------------------------- */

#config-screen {
    width: 60%;
    height: auto;
    dock: top;
    layout: vertical;
    content-align-vertical: middle;
    border: round #7c4dff;
    background: #232323;
    color: #e6e6e6;
    padding: 1 2;
}

#config-screen #config-title {
    text-style: bold;
    padding-bottom: 1;
}

#config-screen #config-actions {
    dock: bottom;
    height: 3;
    align-horizontal: center;
}

#config-screen #target-topic {
    width: 1fr;
    height: 8;
}

#config-screen #exclude-topic {
    width: 1fr;
    height: 3;
}

#config-screen #generate-prompt {
    margin: 0 0 1 0;
    background: #2f9e44;
    color: #ffffff;
}

#config-screen #no-db {
    background: #bdbdbd;
    color: #bdbdbd;
}

#config-screen #no-db.-on {
    background: #2f9e44;
    color: #2f9e44;
}

#config-screen #confirm {
    background: #2f9e44;
    color: #ffffff;
}

#config-screen #cancel {
    background: #d9534f;
    color: #ffffff;
}

#config-screen Input {
    background: #1b1b1b;
    color: #e6e6e6;
}
